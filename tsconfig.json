{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@rsbuild/core/types", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"]
    }
  },
  "include": [
    "src/**/*",
    "*.config.ts",
    "env.d.ts",
    "auto-imports.d.ts",
    "components.d.ts",
    "tests/**/*.ts",
    "build/**/*.ts"
  ]
}
