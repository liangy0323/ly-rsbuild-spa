{
  "name": "ly-rsbuild-spa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --env-mode development --config build/rsbuild.dev.config.ts",
    "build": "pnpm build:prod",
    "build:prod": "rsbuild build --env-mode production --config build/rsbuild.prod.config.ts",
    "preview": "rsbuild preview --env-mode production --config build/rsbuild.prod.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "clean": "rimraf dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "1.78.0",
    "axios": "1.21.1",
    "pinia": "4.1.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@rsbuild/core": "2.3.3",
    "@rsbuild/plugin-image-compress": "1.3.4",
    "@rsbuild/plugin-sass": "2.0.1",
    "@rsbuild/plugin-vue": "2.0.1",
    "@rstest/adapter-rsbuild": "0.12.6",
    "@rstest/core": "0.12.6",
    "@types/js-cookie": "3.0.6",
    "@types/node": "22.20.5",
    "compression-webpack-plugin": "12.0.0",
    "husky": "9.1.7",
    "prettier": "^3.10.1",
    "rimraf": "6.1.4",
    "sass": "1.108.2",
    "typescript": "6.0.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vue-tsc": "3.3.14"
  }
}
